COMPLIANCE_IMAGE=local/compliance-pi-platform:0.1.0
PI_WORKER_IMAGE=local/compliance-pi-worker:0.1.0
POSTGRES_IMAGE=postgres:16.4-bookworm
POSTGRES_PASSWORD=replace-before-deploy
COMPLIANCE_DATABASE_URL=postgresql+psycopg://compliance:replace-before-deploy@postgres:5432/compliance
INTERNAL_TOKEN=replace-with-a-long-random-secret
COMPLIANCE_ENVIRONMENT=production
PI_MODEL_BASE_URL=http://qwen.internal.example/v1
PI_MODEL_ID=server-model-id
PI_MODEL_API_KEY=
OCR_ENDPOINT=http://ocr.internal.example/ocr
OCR_PROVIDER=http-json
OCR_AUTHORIZATION=
VISION_ENDPOINT=
VISION_MODEL=
VISION_AUTHORIZATION=
CALLBACK_ALLOWED_HOSTS=callback.internal.example
COMPLIANCE_PORT=8092
MAX_MODEL_CONCURRENCY=2
MAX_TOOL_CONCURRENCY=4
# No total inspection deadline. This guards one model HTTP request only.
PI_MODEL_REQUEST_TIMEOUT_MS=120000
PI_MAX_TOOL_CALLS=80
MAX_OCR_CONCURRENCY=2
COMPLIANCE_HOST_COLLECTION_SWEEP=true
MAX_DOCUMENT_CONCURRENCY=4
PROVIDER_MAX_ATTEMPTS=2
PI_MAX_TOTAL_PAGES=5000
# Optional trusted authority/review keys; never expose these to Pi or browsers.
COMPLIANCE_SCOPE_PROOF_KEY=
COMPLIANCE_EVIDENCE_REVIEW_KEY=
COMPLIANCE_EVIDENCE_REVIEW_RECEIPTS=
COMPLIANCE_INPUT_DIR=../../fixtures
COMPLIANCE_CONFIG_DIR=../../config
